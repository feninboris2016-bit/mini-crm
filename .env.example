# ------------------------------------------------------------------------------
# Конфигурация Мини-CRM (Production / Development)
# ------------------------------------------------------------------------------

# Порт сервера
PORT=3000

# Окружение: development | production | test
NODE_ENV=development

# База данных PostgreSQL (Neon, Supabase, Render, Railway или локальный Postgres)
# Пример: postgres://user:password@ep-sample-1234.neon.tech/minicrm?sslmode=require
# Если параметр не указан, локально автоматически используется встроенная SQLite база (data/crm.sqlite)
DATABASE_URL=

# Секрет для подписи JWT-токенов администратора (сгенерируйте надежную строку)
JWT_SECRET=change-this-to-a-very-secure-random-32-char-string

# Разрешенный домен подключенного сайта (CORS)
# Пример: https://tristar-pc.ru или https://guileless-arithmetic-de5496.netlify.app
ALLOWED_ORIGIN=*

# Публичный ключ для отправки лидов с сайта (передается в заголовке X-Site-Key)
# Защищает от отправки заявок посторонними ресурсами
SITE_API_KEY=crm_site_key_demo_secret_2026

# Секретный ключ для вызова cron-обработчика очереди извне (например, cron-job.org / Vercel Cron)
CRON_SECRET=crm_cron_secret_worker_2026

# Email настройки по умолчанию (также настраиваются через веб-интерфейс CRM)
RECIPIENT_EMAIL=pk.market26@yandex.ru
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=pk.market26@yandex.ru
SMTP_SECURE=true

# Telegram настройки по умолчанию (также настраиваются через веб-интерфейс CRM)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
